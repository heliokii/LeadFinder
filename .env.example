# --- Database ---
# Localhost (zero setup): SQLite file inside prisma/.
DATABASE_URL="file:./dev.db"
# Vercel: filesystem is read-only except /tmp, and it is ephemeral (data
# resets on cold boot/redeploy). vercel.json already ships
# DATABASE_URL=file:/tmp/leadfinder.db for deploys, so you don't need to set
# anything — but expect demo-only persistence there. For permanent hosted
# storage, swap Prisma to Postgres (Supabase/Neon/Prisma Postgres) instead.

# --- Data source: OpenStreetMap (free, no API key) ---
# Nominatim (geocoding) and Overpass (place search) both require a real,
# identifying User-Agent per their usage policy. Put your name/email or
# project URL here — do NOT leave this as a generic default in production use.
# Both services actively police this header, and the two failure modes look
# different: a placeholder contact (anything on example.com) gets Nominatim
# 403, while a browser-spoofing "Mozilla/5.0 (compatible; ...)" UA gets
# Overpass 406. A plain descriptive UA with your email appended is correct.
OSM_USER_AGENT="lead-finder-personal/1.0 (personal use; your-email@your-domain.com)"

# Overpass endpoint. The default public instance is fine for personal,
# low-volume use. If you hit rate limits, switch to a mirror, e.g.
# https://overpass.kumi.systems/api/interpreter
OVERPASS_ENDPOINT="https://overpass-api.de/api/interpreter"
NOMINATIM_ENDPOINT="https://nominatim.openstreetmap.org/search"

# Minimum delay (ms) between outgoing requests to OSM services.
# Nominatim's usage policy caps free use at ~1 request/second.
OSM_MIN_REQUEST_INTERVAL_MS=1200

# --- Optional: alternate/backup free-tier data sources ---
# Leave blank if unused. See README "Data sources" section for notes on
# when these are worth adding (they can return ratings/reviews, which OSM
# does not have).
GEOAPIFY_API_KEY=""
FOURSQUARE_API_KEY=""

# --- Target market ---
# ISO 3166-1 alpha-2 country code used to parse OSM phone tags written in
# local format with no country code ("0412 345 678" => +61412345678). The
# target market is Australia, so this is AU. A single search can override it
# via the Country field on the search page (that's the `country` body param
# on /api/search); this is just the fallback for everything else.
DEFAULT_COUNTRY_CODE="AU"
# ISO 4217 currency for the payment message generated when a lead is WON.
DEFAULT_CURRENCY="AUD"

# --- Payment links shown on the "mark as won" screen ---
# These are just links/handles you already have — nothing here calls a
# payment API. Leave any of them blank to omit from the generated message.
PAYPAL_ME_HANDLE=""
WISE_ACCOUNT_DETAILS=""
PAYONEER_PAYMENT_LINK=""

# --- App ---
# A shared secret so the dashboard isn't wide open if you ever deploy it
# somewhere reachable over the network. Leave blank for pure localhost use.
APP_ACCESS_CODE=""
